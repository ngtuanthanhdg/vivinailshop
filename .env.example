# Sao chép file này thành .env.local rồi điền giá trị thật.
# Cách lấy từng giá trị: xem HUONG_DAN_NEON_IMAGEKIT.md

# Mã PIN đăng nhập trang quản lý (NÊN ĐỔI trước khi đưa web lên mạng)
OWNER_PIN=8888
STAFF_PIN=1234

# ── Neon (database: sản phẩm, đơn hàng, khách hàng, cài đặt) ──
# Neon Console → Connect → bật "Connection pooling" → copy chuỗi bắt đầu bằng postgresql://
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ── ImageKit (lưu ảnh) ──
# ImageKit Dashboard → Developer options → API keys → Private key (giữ bí mật, KHÔNG có tiền tố NEXT_PUBLIC_)
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxx
# Thư mục chứa ảnh trên ImageKit (tuỳ chọn, mặc định /vivi-nailshop)
# IMAGEKIT_FOLDER=/vivi-nailshop
